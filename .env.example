# Local Postgres from docker compose, or an existing server on localhost.
# No cloud credentials. Do not put production secrets in this file.
DATABASE_URL=postgres://photo:photo@localhost:5432/photocrm

# Better Auth. Use a long random string outside this example.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public pages resolve the studio by slug. Never send a studio id from the browser.
PUBLIC_STUDIO_SLUG=atelier-north
STUDIO_TIMEZONE=America/New_York

# Cloudflare R2 via the S3 API. Leave blank locally; /api/health reports storage "not configured".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional CDN hostname. Gallery and portfolio reads are signed either way.
R2_PUBLIC_BASE_URL=

# Resend. Booking mail is logged and skipped when this is empty.
RESEND_API_KEY=
RESEND_FROM="Atelier North <bookings@example.com>"

# Optional hosted Postgres. The app reads DATABASE_URL only.
# NEON_DATABASE_URL=
